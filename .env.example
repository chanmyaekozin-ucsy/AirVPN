# ─── AirVPN Unified Web & Telegram Bot Configuration ─────────────────────────

# App URL & Environment
APP_URL=https://airnetwork.flash-myanmar.com
NEXT_PUBLIC_APP_URL=https://airnetwork.flash-myanmar.com
NODE_ENV=production
PORT=3000

# Admin Panel Authentication
# Initial admin password (defaults to "admin123" if empty)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
# JWT Secret for user session cookies
JWT_SECRET=generate_a_random_32_character_jwt_secret_key

# ─── Telegram Bot & Notifications ───────────────────────────────────────────
# Official Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram Supergroup ID for Admin Payment Notifications & Alerts (e.g. -1001234567890)
PAYMENTS_PROOFS_GROUP_ID=-1001234567890
# Comma-separated admin Telegram user IDs (fallback recipient)
ADMIN_TELEGRAM_IDS=123456789,987654321

# ─── Payments & Gateways ───────────────────────────────────────────────────
# Dominate Gateway API (Direct KBZPay / WavePay integration)
DOMINATE_GATEWAY_URL=https://api.dominate.to
DOMINATE_GATEWAY_API_KEY=your_dominate_gateway_api_key

# WathanPay Mini App / In-App Checkout
NEXT_PUBLIC_WATHANPAY_MINIAPP=true
NEXT_PUBLIC_WATHANPAY_MERCHANT_ID=
NEXT_PUBLIC_WATHANPAY_CLIENT_ID=

# Google Sign-In (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=