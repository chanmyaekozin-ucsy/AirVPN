# ─── AirVPN Unified Web & Telegram Bot Configuration ─────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.
# Generate secrets with: openssl rand -hex 32  (or -base64 48)

# ─── 1. App URL & Web Server ────────────────────────────────────────────────
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
PORT=3000

# ─── 2. Admin Authentication & Session Security ──────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Session signing secret (REQUIRED). Rotate = all sessions invalidated.
AUTH_SECRET=<generate-with-openssl-rand-hex-32>

# Legacy — kept only for compatibility; can be removed once nothing reads it.
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Encrypts panel credentials at rest in data/store.json (REQUIRED in prod).
# If lost, re-enter panel credentials in Admin → Servers.
STORE_SECRET=<generate-with-openssl-rand-hex-32>

# ─── 3. Trusted Proxy / Rate Limiting ────────────────────────────────────────
# Comma-separated proxy IPs/CIDRs that may set client IP headers (e.g. your
# Cloudflare edge or reverse proxy). Leave empty when running without a proxy.
TRUSTED_PROXIES=

# ─── 4. Telegram Bot & Notification Channels ─────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
# Telegram Admin Supergroup ID for payment & cancellation notifications
PAYMENTS_PROOFS_GROUP_ID=
# Admin Telegram user IDs (fallback notification recipient)
ADMIN_TELEGRAM_IDS=
# Dedicated webhook secret for X-Telegram-Bot-Api-Secret-Token (REQUIRED in prod).
TELEGRAM_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
# Admin Support Telegram usernames (comma-separated, without @)
ADMIN_ACCOUNTS=

# ─── 5. Payments & Payment Gateway Integration ──────────────────────────────
# Dominate Gateway API (Direct KBZPay / WavePay integration)
DOMINATE_GATEWAY_URL=https://pgw.example.com
DOMINATE_GATEWAY_API_KEY=
# Secret used to verify webhook HMAC signatures (X-Signature-SHA256).
DOMINATE_WEBHOOK_SECRET=<generate-or-copy-from-gateway-dashboard>

# WathanPay Mini App / In-App Checkout & Server-to-Server Verification
NEXT_PUBLIC_WATHANPAY_MINIAPP=true
WATHANPAY_API_URL=https://api.wathanpay.com
# Secret Key (Backend HMAC authData verification and payment verification)
WATHANPAY_MERCHANT_SECRET=

# Google Sign-In (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
