AUTH_SECRET=change-me-to-a-long-random-string

ADMIN_EMAIL=admin@airvpn.mm
ADMIN_PIN=123456

# Dominate Payment Gateway (KBZPay / WavePay on standalone web)
# Use AirVPN project key from Dominate admin
DOMINATE_GATEWAY_URL=https://pgw.flash-myanmar.com
DOMINATE_GATEWAY_API_KEY=

# WathanPay Core API & Merchant API Key (for Zero-Trust Server-to-Server Payment Verification)
# Default: https://api.wathanpay.com (Production) or http://localhost:3001 (Local Dev)
WATHANPAY_API_URL=https://api.wathanpay.com
WATHANPAY_API_KEY=wp_live_pk_xxxxxxxxxxxxxxxx


# VLESS / 3x-ui panel settings are configured per server in Admin → Servers
# (not via env). Set Subscription base URL there too.

